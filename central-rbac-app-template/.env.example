# Central RBAC app template — env config example.
# Copy to `.env` và điền giá trị thật (KHÔNG commit .env).

# Central RBAC base URL (production or dev)
CENTRAL_URL=https://rbacnb.000nethost.com

# App slug — MUST match rbac.apps.slug đã đăng ký với Central wizard
APP_SLUG=template-app

# Per-app X-Rbac-Token — format rbac_<8prefix>_<24secret>
# Get from Central Admin UI:
#   1. When registering app via wizard: one-time reveal in response modal
#   2. Or create additional token at /apps/<slug>/tokens (Central UI)
# Legacy shared token still works until 2028-01-01 but SDK logs warning.
CENTRAL_RBAC_TOKEN=rbac_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# App HTTP port
PORT=3000
