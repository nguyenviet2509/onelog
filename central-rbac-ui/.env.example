# ============================================================
# central-rbac-ui — Environment Variables
# Copy to .env.local and fill in values before running.
# ============================================================

# API base URL — same-origin via Traefik (no trailing slash)
# Review mode: /v1  |  Production: /v1
VITE_API_BASE_URL=/v1

# Zitadel OIDC issuer URL (no trailing slash)
# Review mode:  http://10.200.0.125:8080
# Production:   https://zitadel.<domain>
VITE_ZITADEL_ISSUER=http://10.200.0.125:8080

# OIDC client ID registered in Zitadel Console
# Console → Projects → central-rbac → Applications → Web OIDC → client_id
VITE_ZITADEL_CLIENT_ID=central-rbac-ui

# OIDC redirect URI — must match Zitadel app config exactly
# Review mode:  http://10.200.0.125:8082/callback
# Production:   https://rbac.<domain>/callback
VITE_ZITADEL_REDIRECT_URI=http://10.200.0.125:8082/callback

# Show "REVIEW MODE" yellow banner when true
# Set to false in production
VITE_REVIEW_MODE=true
