# =============================================================================
# Central RBAC — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres: writer connection (rbac_writer role, INSERT on rbac.*, INSERT-only on audit_log) ---
WRITER_DATABASE_URL=postgresql://rbac_writer:changeme@localhost:5433/central_rbac

# --- Postgres: auditor connection (rbac_auditor role, SELECT on audit_log only) ---
AUDITOR_DATABASE_URL=postgresql://rbac_auditor:changeme@localhost:5433/central_rbac

# --- Zitadel / JWT verification ---
# Issuer — must match `iss` claim in JWT. Use internal alias on authway-vps.
ZITADEL_ISSUER=http://10.200.0.125:8080
# JWKS endpoint. For local dev: SSH tunnel then set to http://localhost:8080/oauth/v2/keys
# ssh -L 8080:10.200.0.125:8080 onelog-vps
ZITADEL_JWKS_URL=http://10.200.0.125:8080/oauth/v2/keys
# Expected `aud` claim value (client ID of central-rbac-ui app in Zitadel)
ZITADEL_AUD_CLIENT_ID=central-rbac-ui@<project_id>
# Expected `azp` claim value (admin client authorized to call this API)
ZITADEL_AZP_ADMIN_CLIENT_ID=central-rbac-admin@<project_id>

# --- /v1/resolve auth (REQUIRED — startup fails if empty) ---
# Constant-time compared against X-Rbac-Token header (inline call mode)
CENTRAL_RBAC_RESOLVE_TOKEN=change-me-to-a-strong-random-secret

# --- /v1/resolve HMAC signing (webhook/Zitadel Action mode) ---
# Key used to verify HMAC-SHA256 header: zitadel-signature: t=<ts>,v1=<hex>
ZITADEL_ACTION_SIGNING_KEY=change-me-to-a-strong-random-key

# --- VictoriaLogs dual-write sink ---
VL_INGEST_URL=http://onelog-vps:9428/insert/jsonline?_stream_fields=level,service&_stream=rbac-audit

# --- CORS allowed origins (Phase 5 UI subdomain, H2 fix) ---
# Comma-separated list of allowed origins. Leave empty to block all cross-origin
# requests in production (safe default). Dev with no value falls back to allow-all.
# Example: CENTRAL_RBAC_CORS_ORIGIN=https://rbac.inet.vn,https://admin.inet.vn
CENTRAL_RBAC_CORS_ORIGIN=

# --- Dev-only webhook echo endpoint (set false in prod) ---
WEBHOOK_ECHO_ENABLED=true

# --- Redis (stubbed Phase 1, required Phase 2+) ---
# REDIS_URL=redis://localhost:6379
