{
  "name": "central-rbac",
  "version": "0.1.0",
  "description": "Central RBAC backend — permissions, roles, audit, JWT verify",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/app.js",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap-dev": "tsx scripts/bootstrap-dev.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "fastify": "^4.29.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.1",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
