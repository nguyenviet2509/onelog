{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "title": "Authway Overview",
  "uid": "authway-overview",
  "schemaVersion": 39,
  "tags": ["authway", "zitadel", "monitoring"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Zitadel container UP",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "up{job=\"authway_zitadel\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "id": 2,
      "title": "HTTPS probe success",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "probe_success{job=\"authway_blackbox_http\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "FAIL", "color": "red"}, "1": {"text": "OK", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "LDAP TCP probe",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "probe_success{job=\"authway_blackbox_tcp_ldap\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "OK", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Cert days remaining",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "(probe_ssl_earliest_cert_expiry{job=\"authway_blackbox_http\"} - time()) / 86400", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 7}, {"color": "green", "value": 30}]}
        }
      }
    },
    {
      "id": 5,
      "title": "Postgres container UP",
      "type": "stat",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "max(container_last_seen{name=~\".*authway-prod-postgres.*\",job=\"authway_cadvisor\"} > (time() - 60))", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}},
            {"type": "special", "options": {"match": "null", "result": {"text": "N/A", "color": "orange"}}}
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Zitadel HTTP request rate (by status)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "sum by (status_code) (rate(http_server_request_count_total{job=\"authway_zitadel\"}[5m]))", "legendFormat": "{{status_code}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "title": "Zitadel gRPC request rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "sum by (grpc_method) (rate(grpc_server_handled_total{job=\"authway_zitadel\"}[5m]))", "legendFormat": "{{grpc_method}}", "refId": "A"}
      ]
    },
    {
      "id": 20,
      "title": "CPU % — authway-vps host",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "avg by (mode) (rate(node_cpu_seconds_total{job=\"authway_node\"}[1m])) * 100", "legendFormat": "{{mode}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "custom": {"stacking": {"mode": "normal"}}}}
    },
    {
      "id": 21,
      "title": "Memory used / total",
      "type": "gauge",
      "gridPos": {"x": 8, "y": 12, "w": 4, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "(1 - (node_memory_MemAvailable_bytes{job=\"authway_node\"} / node_memory_MemTotal_bytes{job=\"authway_node\"})) * 100", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}
        }
      }
    },
    {
      "id": 22,
      "title": "Disk usage %",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 12, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "(1 - (node_filesystem_avail_bytes{job=\"authway_node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"authway_node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"})) * 100", "legendFormat": "{{mountpoint}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}
        }
      }
    },
    {
      "id": 23,
      "title": "Container CPU % (top 5)",
      "type": "timeseries",
      "gridPos": {"x": 18, "y": 12, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "topk(5, sum by (name) (rate(container_cpu_usage_seconds_total{job=\"authway_cadvisor\",name!=\"\"}[1m])) * 100)", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 30,
      "title": "HTTPS probe latency (s)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "probe_duration_seconds{job=\"authway_blackbox_http\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 31,
      "title": "Container network bytes/s (all containers)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "targets": [
        {"expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"authway_cadvisor\",name!=\"\"}[1m]))", "legendFormat": "{{name}} rx", "refId": "A"},
        {"expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"authway_cadvisor\",name!=\"\"}[1m]))", "legendFormat": "{{name}} tx", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    }
  ]
}
