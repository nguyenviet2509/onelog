{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "title": "SSO Login Trace",
  "uid": "sso-login-trace",
  "schemaVersion": 39,
  "tags": ["sso", "central-rbac", "zitadel", "authway", "trace"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "user_email",
        "type": "textbox",
        "label": "user_email",
        "current": {"value": "*", "text": "*"},
        "query": "*",
        "description": "Filter by exact user_email. Default '*' = show all logs carrying user_email/actor_email field. LogsQL treats '*' as wildcard match on the field."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Login timeline (Central + Zitadel) — filter by $user_email",
      "type": "logs",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 12},
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "targets": [
        {
          "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
          "expr": "host:authway AND (service:central-rbac OR service:zitadel) AND (user_email:$user_email OR actor_email:$user_email)",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 2,
      "title": "Central RBAC — 5xx error rate (per URL, 5m)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "targets": [
        {
          "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
          "expr": "host:authway AND service:central-rbac AND res.statusCode:>=500 | stats by (req.url) count() as errors",
          "queryType": "stats",
          "legendFormat": "{{req.url}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}
      }
    },
    {
      "id": 3,
      "title": "Central RBAC — response time p95 (per URL)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "targets": [
        {
          "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
          "expr": "host:authway AND service:central-rbac AND responseTime:* | stats by (req.url) quantile(0.95, responseTime) as p95_ms",
          "queryType": "stats",
          "legendFormat": "p95 {{req.url}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 4,
      "title": "Brute-force detect — password.check.failed > 5 in 15m (per ip, user_email)",
      "type": "table",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "targets": [
        {
          "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
          "expr": "host:authway AND service:zitadel AND _msg:*password.check.failed* | stats by (ip, actor_email) count() as fails | filter fails:>5",
          "queryType": "stats",
          "refId": "A"
        }
      ]
    }
  ]
}
