# VictoriaMetrics scrape config TEMPLATE — pulls /metrics from OneLog components.
# Fed to victoriametrics service via -promscrape.config.
#
# Rendering: `bash infra/scripts/render-scrape.sh` substitutes ${QDRANT_API_KEY}
# and ${LITELLM_MASTER_KEY} from infra/.env into scrape.yml (gitignored).
# Do this before `docker compose --profile monitoring up -d`.
#
# Add scrape targets carefully: only endpoints that already expose Prometheus
# metrics natively. Adding Vector requires enabling its `prometheus_exporter`
# sink (not free — extra port + config). Deferred to Phase 2.

global:
  scrape_interval: 30s
  scrape_timeout: 10s

scrape_configs:
  # Indexer — Drain3 batch/embed worker. Already exposes /metrics on :9100
  # (see infra/docker-compose.yml → indexer.METRICS_PORT).
  - job_name: onelog-indexer
    static_configs:
      - targets: ["indexer:9100"]
        labels:
          component: indexer

  # VictoriaLogs — /metrics on :9428 (native Prometheus format).
  - job_name: onelog-victorialogs
    metrics_path: /metrics
    static_configs:
      - targets: ["victorialogs:9428"]
        labels:
          component: victorialogs

  # Qdrant — /metrics on :6333. Requires Bearer auth when QDRANT__SERVICE__API_KEY set.
  # ${QDRANT_API_KEY} is substituted by infra/scripts/render-scrape.sh.
  - job_name: onelog-qdrant
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials: "${QDRANT_API_KEY}"
    static_configs:
      - targets: ["qdrant:6333"]
        labels:
          component: qdrant

  # vmalert — /metrics on :8880.
  - job_name: onelog-vmalert
    static_configs:
      - targets: ["vmalert:8880"]
        labels:
          component: vmalert

  # LiteLLM proxy — /metrics endpoint on :4000/metrics (Prometheus format
  # requires config.yaml litellm_settings.callbacks: [prometheus]).
  # /metrics requires Bearer auth unless litellm_settings.require_auth_for_metrics_endpoint: false.
  - job_name: onelog-litellm
    authorization:
      type: Bearer
      credentials: "${LITELLM_MASTER_KEY}"
    static_configs:
      - targets: ["litellm-proxy:4000"]
        labels:
          component: litellm

  # VictoriaMetrics self-scrape.
  - job_name: victoriametrics
    static_configs:
      - targets: ["victoriametrics:8428"]
        labels:
          component: victoriametrics

  # node-exporter — host CPU/RAM/network/disk. Container is on the ragstack
  # bridge network with /proc, /sys bind-mounted, so metrics reflect the real
  # host without needing network_mode: host.
  - job_name: onelog-host
    static_configs:
      - targets: ["node-exporter:9101"]
        labels:
          component: host

  # Caddy — /metrics via admin API :2019 (admin bound to :2019 inside container,
  # NOT published to host). Requires Caddyfile global option `admin :2019`.
  - job_name: onelog-caddy
    metrics_path: /metrics
    static_configs:
      - targets: ["caddy:2019"]
        labels:
          component: caddy

  # Grafana — subpath /grafana/metrics because GF_SERVER_SERVE_FROM_SUB_PATH=true
  # and GF_SERVER_ROOT_URL ends with /grafana/. Unauthenticated by default.
  - job_name: onelog-grafana
    metrics_path: /grafana/metrics
    static_configs:
      - targets: ["grafana:3000"]
        labels:
          component: grafana

  # oauth2-proxy — requires --metrics-address=0.0.0.0:44180 in service command.
  # No host port publish; only reachable inside ragstack network.
  - job_name: onelog-oauth2-proxy
    metrics_path: /metrics
    static_configs:
      - targets: ["oauth2-proxy:44180"]
        labels:
          component: auth

  # Alertmanager — native /metrics on :9093. Self-scrape covers notification
  # failure counters (alertmanager_notifications_failed_total).
  - job_name: onelog-alertmanager
    metrics_path: /metrics
    static_configs:
      - targets: ["alertmanager:9093"]
        labels:
          component: alertmanager

  # NATS — prometheus-nats-exporter exposes gnatsd_varz_* / connz_* / jsz_*
  # on :7777 (bridged from NATS monitor endpoint :8222).
  - job_name: onelog-nats
    metrics_path: /metrics
    static_configs:
      - targets: ["nats-exporter:7777"]
        labels:
          component: nats
