{
  "schema": "1",
  "service": "onelog-agent",
  "version": "0.1.0",
  "permissions": [
    {
      "id": "onelog-agent:chat.query",
      "description": "Submit /chat SSE agent loop query (triage + retrieval)"
    },
    {
      "id": "onelog-agent:alert.push",
      "description": "Send alert webhook to /alert (Alertmanager only)"
    },
    {
      "id": "onelog-agent:admin.observe",
      "description": "Read admin metrics/health (future /admin/* endpoints)"
    }
  ],
  "default_roles": [
    {
      "key": "onelog-agent.viewer",
      "description": "Agent Viewer — can query /chat",
      "permissions": [
        "onelog-agent:chat.query"
      ]
    },
    {
      "key": "onelog-agent.admin",
      "description": "Agent Admin — all perms",
      "permissions": [
        "onelog-agent:chat.query",
        "onelog-agent:alert.push",
        "onelog-agent:admin.observe"
      ]
    }
  ]
}
